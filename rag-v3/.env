# Clinical Knowledge Assistant — frontend environment (copy to .env)
#
# Base URL of the FastAPI backend as seen from the BROWSER (no trailing slash).
#   dev server (npm run dev):      http://localhost:8000   (backend CORS allows http://localhost:5173 by default)
#   Docker/nginx image:            /api                    (nginx proxies to the backend; same origin, no CORS)
# There is no offline "demo mode": without a reachable backend the app says so and cannot answer.
VITE_API_BASE_URL=http://localhost:8000
