# Copy to .env and configure

# Ollama server
OLLAMA_BASE=http://localhost:11434
OLLAMA_KEEPALIVE=5m

# Embedding model (do not change unless you switch embedding model)
EMBED_MODEL=bge-m3

# ── Multi-model LLM config ────────────────────────────────────────────────────
# DEFAULT_LLM: which model to use when frontend sends none ("llama" or "qwen")
DEFAULT_LLM=llama

# Exact Ollama model names — must match `ollama list` output
LLM_MODEL_LLAMA=llama3.1:latest
LLM_MODEL_QWEN=qwen2.5:3b

# Pull commands:
#   ollama pull llama3.1:latest
#   ollama pull qwen2.5:3b
# ─────────────────────────────────────────────────────────────────────────────

# Knowledge ingestion (Phase 2)
# KNOWLEDGE_DB_PATH=./data/knowledge.db
MAX_DOC_BYTES=52428800
CHUNK_MAX_WORDS=180
EMBED_BATCH=32

# Patient encounters (Phase 5) — separate DB file; idle encounters are erased after this many hours (0 = never)
# ENCOUNTER_DB_PATH=./data/encounters.db
ENCOUNTER_TTL_HOURS=24

# Retrieval and grounding (Phase 3) — thresholds are starting points; calibrate with `python -m knowledge.eval`
TOP_K=6
SIM_THRESHOLD=0.25
MIN_LEXICAL_COVERAGE=0.5
RETRIEVE_OVERFETCH=4
MAX_CTX_CHUNKS=5
MAX_CONTEXT_WORDS=1400
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=600

# Server
# Comma-separated allowed browser origins (default: the local Vite/CRA dev servers). Never use * with patient data.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HOST=127.0.0.1   # listen address; 0.0.0.0 exposes the API to your network
PORT=8000
RELOAD=true
